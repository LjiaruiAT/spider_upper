<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spider_task</name>
  <version>0.0.0</version>
  <description>Learning-stage task node for publishing configured spider servo targets and receiving high-level velocity commands.</description>
  <maintainer email="liujiarui@example.com">liujiarui</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <!-- 单腿 IK 节点复用 leg_calc 的运动学核心库（leg_calc_core） -->
  <depend>leg_calc</depend>
  <depend>rclcpp</depend>
  <depend>robot_interfaces</depend>

  <!-- 手动调试节点在运行时读 spider/config/default_pose.yaml（初值姿态）。 -->
  <exec_depend>spider</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
